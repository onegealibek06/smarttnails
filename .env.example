# Скопируйте этот файл в .env и заполните хотя бы один способ доставки.
# Без них форма в подвале предложит клиентке отправить сообщение через WhatsApp.

# Telegram: бот от @BotFather и chat id Ардак (бот должен получить от неё /start)
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Email через resend.com: ключ API и адрес, куда присылать письма
NUXT_RESEND_API_KEY=
NUXT_CONTACT_EMAIL=
